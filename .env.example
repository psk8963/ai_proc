# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# ---- Oracle (조회 전용 계정 권장) ----
ORACLE_USER=
ORACLE_PASSWORD=
# 호스트:포트/서비스명  또는  tnsnames.ora 별칭(ORACLE_TNS_ADMIN 지정 시, Toad 접속 목록의 이름)
ORACLE_DSN=10.0.0.1:1521/ORCL
# tnsnames.ora 가 있는 폴더 (Toad 가 쓰는 것. 예: C:\oracle\product\11.2.0\client_1\network\admin)
ORACLE_TNS_ADMIN=
# 메타데이터를 읽을 스키마(쉼표 구분). 비우면 접속 계정 스키마 + 시노님 대상 스키마
ORACLE_SCHEMAS=
# DB 서버가 11g 일 때만: Instant Client 19 이상 64bit 폴더 (thick 모드). PC 의 11g 클라이언트는 사용 불가
# 예: C:\workspace\ai_proc\instantclient_19_29
ORACLE_CLIENT_LIB_DIR=
# 메타데이터 갱신 범위: referenced(소스가 쓰는 테이블만, 기본) / all(스키마 전체 — 느림)
ORACLE_META_SCOPE=referenced
# 메타데이터 갱신 제한 시간(ms). 11g 에서 오래 걸리면 늘린다
META_CALL_TIMEOUT_MS=600000
# DB 문자셋 한 글자 바이트 수 (AL32UTF8=3, KO16MSWIN949=2) — VARCHAR2(n CHAR) 계산용
DB_BYTES_PER_CHAR=3

# ---- Pro*C 실행 서버 ----
# C long 크기: 64bit 유닉스(AIX/HP-UX/Linux)=64, Windows=32
HOST_LONG_BITS=64

# ---- LLM (ai_nexacro 와 동일) ----
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=gemma4:e2b
LLM_NUM_CTX=8192
